{
  "name": "deepseek-harness-app",
  "description": "Tauri 2 shell that launches or connects to official dsh web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mouseww/deepseek-harness-app.git"
  },
  "upstream": {
    "repository": "https://github.com/deepseek-ai/deepseek-harness",
    "package": "@deepseek-ai/dsh",
    "version": "0.1.0-rc.7"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tauri build",
    "build:ui": "tsc -p tsconfig.json --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
