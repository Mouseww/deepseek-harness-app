{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness App",
  "version": "1.0.0",
  "identifier": "ai.deepseek.harness.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "DeepSeek Harness"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DeepSeek AI",
    "copyright": "Copyright (c) 2026 DeepSeek AI",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform desktop app for DeepSeek Harness",
    "longDescription": "DeepSeek Harness App is a high-performance, cross-platform desktop application built with Tauri 2.0. It provides a native interface for interacting with DeepSeek Harness AI agents."
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "npx",
          "cmd": "npx",
          "args": true,
          "sidecar": false
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": true,
          "sidecar": false
        }
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/deepseek-ai/deepseek-harness-app/releases/latest"
      ],
      "pubkey": "TO_BE_GENERATED"
    }
  }
}
